{
  "name": "room-vibez-hackathon-3d-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/build-assets.mjs",
    "farm": "node scripts/farm-job.mjs",
    "stub-mjs": "node scripts/emit-stub-mjs.mjs",
    "bake-color0": "node scripts/bake-color0.mjs",
